# 环境变量模板
# 用法: cp .env.example .env 后按需修改, 然后:
#     set -a; source .env; set +a; ./deploy.sh
# (set -a 必需: 直接 source 只在当前 shell 生效, 不会传给 deploy.sh)
#
# ⚠️ 优先级: 环境变量 > config.yaml 的 exchange: 段 > 默认值(主网)
#    三个网络变量都不设置时使用主网(真实资金)。首次使用建议保持测试网。

# 交易所网络 (true=测试网, false=主网/实盘; 不设置=主网)
BINANCE_TESTNET=true
HYPERLIQUID_TESTNET=true
DERIBIT_TESTNET=true

# 数据与日志目录
DATA_DIR=./data
LOG_DIR=./logs

# 服务间通信地址
POSITION_MONITOR_ORDER_SERVICE_URL=http://localhost:8081
POSITION_MONITOR_URL=http://localhost:8080

# 强制重新同步 exchange symbol filters (可选, 修复损坏的 CSV)
# FORCE_RESYNC_FILTERS=true
